BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
BINANCE_WEB3_QUOTE_PATH=/api/v1/dex/aggregator/quote
BINANCE_WEB3_SWAP_PATH=/api/v1/dex/aggregator/swap
BINANCE_WEB3_APPROVE_PATH=/api/v1/dex/aggregator/approve-transaction
BINANCE_WEB3_AGGREGATOR_HISTORY_PATH=/api/v1/dex/aggregator/history
BINANCE_WEB3_SIMULATE_PATH=/api/v1/dex/pre-transaction/simulate
BINANCE_WEB3_GAS_PRICE_PATH=/api/v1/dex/pre-transaction/gas-price
BINANCE_WEB3_GAS_LIMIT_PATH=/api/v1/dex/pre-transaction/gas-limit
BINANCE_WEB3_RWA_TOKENS_PATH=/api/v1/dex/market/rwa/tokens
BINANCE_WEB3_RWA_PRICE_PATH=/api/v1/dex/market/rwa/price
BINANCE_WEB3_RWA_PLATFORMS_PATH=/api/v1/dex/market/rwa/platforms
BINANCE_WEB3_RWA_SEARCH_PATH=/api/v1/dex/market/rwa/search
BINANCE_WEB3_RWA_UNDERLYING_PROFILE_PATH=/api/v1/dex/market/rwa/underlying-profile
BINANCE_WEB3_RWA_UNDERLYING_MARKET_PATH=/api/v1/dex/market/rwa/underlying-market
BINANCE_WEB3_MARKET_CANDLES_PATH=/api/v1/dex/market/candles
BINANCE_WEB3_WALLET_ALL_BALANCES_PATH=/api/v1/dex/balance/all-token-balances-by-address
BINANCE_WEB3_WALLET_PORTFOLIO_OVERVIEW_PATH=/api/v1/dex/market/portfolio/overview
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Independent reference price (server/referencePrice.ts) - required for a real spread signal.
# Binance's own /rwa/* referencePrice is derived from the on-chain price, not independent (confirmed
# empirically, see docs/dx-report-notes.md). Alpaca is primary (WS live + REST snapshot realign),
# Finnhub is the fallback when Alpaca is missing/stale.
ALPACA_KEY=
ALPACA_SECRET=
# A paper account's keys are enough for the free IEX feed we use here (confirmed via Alpaca's own
# forum, not a directly fetchable docs page - see docs/dx-report-notes.md). Paper/live use separate
# key pairs and hosts; a paper key cannot touch a live account.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex
FINNHUB_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
REFERENCE_PRICE_CACHE_MS=1500
REFERENCE_STALE_MS=15000
# Run `npx tsx scripts/build-universe.ts` once the Alpaca keys above are set, to populate this
# from the real Binance x Alpaca intersection (top N most liquid tokens covered by both).
UNIVERSE_PATH=config/universe.json

SLIPPAGE_BPS=50
B402_DEMO_PRICE_USDC=0.10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
VITE_API_BASE_URL=
BSC_USDC_ADDRESS=
TSLAB_ADDRESS=
SPYON_ADDRESS=
NVDAB_ADDRESS=
# Auto-execution watcher (dry-run until an executor is wired in). These are the operator
# defaults the policy boots with; end users can tune min spread/score/liquidity, max trade,
# max daily budget, slippage and cooldown from the Agent Studio page at runtime - see
# GET/POST /api/watcher/policy (overrides persist in data/watcher-policy-overrides.json).
AUTO_ENABLED=false
AUTO_MODE=dry-run
AUTO_INTERVAL_SEC=60
AUTO_MIN_SPREAD_BPS=50
AUTO_MIN_SCORE=35
AUTO_MIN_LIQUIDITY_USD=100000
AUTO_MAX_TRADE_USD=4
AUTO_MAX_DAILY_USD=10
AUTO_MAX_SLIPPAGE_BPS=50
AUTO_COOLDOWN_SEC=7200
AUTO_ALLOWED_SYMBOLS=
AUTO_WALLET_ADDRESS=
AUTO_KILL=false
# TEMPORARY - one-time cumulative spend cap for the build/test phase only (currently $40 total).
# Not a permanent product setting, intentionally hidden from the Agent Studio page, and must be
# unset/removed (along with its evaluate() check in server/policy.ts) before final delivery.
AUTO_TEST_LIFETIME_USD=40
