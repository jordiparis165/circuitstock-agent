{
  "name": "circuitstock",
  "version": "0.1.0",
  "description": "Scan BSC tokenized-stock spreads and prepare safe no-broadcast rebalance transactions.",
  "tools": [
    {
      "name": "scan_tokenized_stock_spreads",
      "method": "POST",
      "path": "/api/agent/recommend/compact"
    },
    {
      "name": "prepare_rebalance",
      "method": "POST",
      "path": "/api/execution/prepare"
    },
    {
      "name": "plain_language_stock_prompt",
      "method": "POST",
      "path": "/api/agent/interpret"
    },
    {
      "name": "resolve_tokenized_stock",
      "method": "GET",
      "path": "/api/rwa/search"
    },
    {
      "name": "premium_signal_demo",
      "method": "POST",
      "path": "/api/premium/signal"
    },
    {
      "name": "dry_run_watcher_status",
      "method": "GET",
      "path": "/api/watcher/status"
    },
    {
      "name": "dry_run_watcher_tick",
      "method": "POST",
      "path": "/api/watcher/tick"
    }
  ],
  "safety": {
    "broadcasts_transactions": false,
    "requires_user_signature": true,
    "chain": "BSC mainnet",
    "spot_only": true
  }
}
